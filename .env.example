# Genovo Technologies - Environment Variables Example
# Copy this file to .env.local or set these variables in your Vercel/Netlify/GitHub Actions deployment

# Option 1: EmailJS Integration (https://www.emailjs.com)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Option 2: Web3Forms Integration (https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Option 3: Custom Formspree Endpoint (https://formspree.io)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
